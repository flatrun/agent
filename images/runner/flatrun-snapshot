#!/usr/bin/env python3
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tarfile
import tempfile


def main():
    parser = argparse.ArgumentParser(description="Reuse declared setup outputs within a FlatRun cache scope")
    parser.add_argument('--key', required=True)
    parser.add_argument('--path', action='append', required=True)
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ['--'] else args.command
    if not command:
        parser.error('a setup command is required after --')
    root = Path.cwd().resolve()
    outputs = []
    for value in args.path:
        p = Path(value)
        if p.is_absolute() or not p.parts or any(x in ('.', '..') for x in p.parts):
            parser.error('paths must be non-empty relative paths without ..')
        if not (root / p).parent.resolve().is_relative_to(root):
            parser.error('output parent must remain inside the working directory')
        if any(p == other or p in other.parents or other in p.parents for other in outputs):
            parser.error('output paths must not overlap')
        outputs.append(p)
    cache_root = Path(os.environ.get('FLATRUN_SNAPSHOT_CACHE', '/flatrun-cache/shared'))
    if not cache_root.is_dir():
        return subprocess.call(command)
    cache = cache_root / 'snapshots'
    cache.mkdir(exist_ok=True)
    identity = json.dumps([args.key, [str(p) for p in outputs], command], separators=(',', ':')).encode()
    name = hashlib.sha256(identity).hexdigest()
    archive = cache / (name + '.tar')
    with (cache / (name + '.lock')).open('a+b') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if archive.is_file() and not any(os.path.lexists(root / p) for p in outputs):
            with tempfile.TemporaryDirectory(prefix='.flatrun-restore-', dir=root) as staging:
                stage = Path(staging)
                with tarfile.open(archive, 'r') as tar:
                    for member in tar.getmembers():
                        member_path = Path(member.name)
                        if member_path.is_absolute() or '..' in member_path.parts or not any(member_path == p or p in member_path.parents for p in outputs):
                            raise ValueError('snapshot contains an undeclared path')
                    tar.extractall(stage, filter='data')
                for p in outputs:
                    source, target = stage / p, root / p
                    if not os.path.lexists(source):
                        raise ValueError('snapshot is missing a declared output')
                    target.parent.mkdir(parents=True, exist_ok=True)
                    if not target.parent.resolve().is_relative_to(root):
                        raise ValueError('output parent escaped the working directory')
                    os.rename(source, target)
            print('FlatRun snapshot restored', flush=True)
            return 0
        status = subprocess.call(command)
        if status:
            return status
        if not all(os.path.lexists(root / p) for p in outputs):
            print('FlatRun snapshot skipped: declared output missing', file=sys.stderr)
            return 0
        fd, temporary = tempfile.mkstemp(prefix=name + '.', suffix='.tmp', dir=cache)
        os.close(fd)
        try:
            status = subprocess.call(['tar', '-cf', temporary, '--', *(str(p) for p in outputs)])
            if status:
                return status
            os.replace(temporary, archive)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        print('FlatRun snapshot saved', flush=True)
        return 0


if __name__ == '__main__':
    sys.exit(main())
