FROM golang:1.21-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -o flatrun-agent ./cmd/agent

FROM alpine:3.19

RUN apk add --no-cache ca-certificates docker-cli docker-cli-compose wget

WORKDIR /app

COPY --from=builder /app/flatrun-agent .
COPY test/e2e/config.test.yml /app/config.yml

RUN mkdir -p /deployments

EXPOSE 8090

CMD ["./flatrun-agent", "-config", "/app/config.yml"]
